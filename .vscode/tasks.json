{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make TOOLCHAIN=/usr/bin/arm-none-eabi-",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}",
            }
        },
        {
            "label": "build & deploy",
            "type": "shell",
            // EDIT ENDLESS_MOUNT to your mounted Endless device before using this.
            // The Makefile emits build/<name>_<timestamp>.endl, not .bin -- the
            // upstream version of this task copied *.bin and always failed.
            "command": "ENDLESS_MOUNT=\"${ENDLESS_MOUNT:-/media/$USER/ENDLESS}\"; rm -f build/*.endl && make TOOLCHAIN=/usr/bin/arm-none-eabi- && cp build/*.endl \"$ENDLESS_MOUNT\"/",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "clear": true
            },
            "options": {
                "cwd": "${workspaceFolder}",
            }
        }
    ]
}